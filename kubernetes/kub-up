#!/bin/sh

# wait for all nodes to be ready before proceeding
echo "...waiting for all nodes to be ready..."
kubectl wait --for=condition=Ready nodes --all --timeout=120s

# bring in cert-manager and wait for its webhook to be ready
# (the NFS mTLS layer below requires cert-manager up before certs can issue)
#
# github.com's release-download endpoint occasionally returns 504 Gateway
# Timeout under elevated load (observed as a persistent CI flake on
# 2026-11-08). kubectl apply is idempotent on this manifest so retrying
# is safe; without this loop a transient blip nukes the entire stack
# bring-up and every downstream integration test with it. Linear
# backoff 10/20/30/40/50s across 5 attempts = 150s worst-case wait,
# well under the 120s cert-manager-webhook-Available wait that follows.
CERT_MANAGER_URL="https://github.com/cert-manager/cert-manager/releases/download/v1.20.2/cert-manager.yaml"
CERT_MANAGER_APPLIED=0
for attempt in 1 2 3 4 5; do
    if kubectl apply --validate=false -f "${CERT_MANAGER_URL}"; then
        CERT_MANAGER_APPLIED=1
        break
    fi
    backoff=$((attempt * 10))
    echo "...cert-manager apply attempt ${attempt} failed; retrying in ${backoff}s..."
    sleep "${backoff}"
done
if [ "${CERT_MANAGER_APPLIED}" -eq 0 ]; then
    echo "ERROR: cert-manager apply failed after 5 attempts."
    echo "Check https://www.githubstatus.com and retry, or"
    echo "download the manifest locally and re-point this script."
    exit 1
fi
echo "...waiting for cert-manager webhook to be ready..."
kubectl wait --for=condition=Available --timeout=120s -n cert-manager deployment/cert-manager-webhook
echo "...waiting 15 seconds for webhook to stabilize..."
sleep 15

# issue all certs, including nfs-server/nfs-client used for the NFS mTLS tunnel
kubectl apply \
    -f certs/selfsigned-issuer.yaml \
    -f certs/ca-certificate.yaml \
    -f certs/ca-issuer.yaml \
    -f certs/mysql.yaml \
    -f certs/mysql-replication.yaml \
    -f certs/mysql-openemr-client.yaml \
    -f certs/phpmyadmin.yaml \
    -f certs/mysql-phpmyadmin-client.yaml \
    -f certs/redis.yaml \
    -f certs/redis-openemr-client.yaml \
    -f certs/sentinel.yaml \
    -f certs/nfs-server.yaml \
    -f certs/nfs-client.yaml
echo "...waiting 15 seconds to ensure certs are created..."
sleep 15

# install csi-driver-nfs (the StorageClass provisioner for the NFS backing).
# Standard upstream manifests, pinned to v4.13.6.
kubectl apply \
    -f csi-nfs/rbac-csi-nfs.yaml \
    -f csi-nfs/csi-nfs-driverinfo.yaml \
    -f csi-nfs/csi-nfs-controller.yaml \
    -f csi-nfs/csi-nfs-node.yaml

# bring up the mTLS-wrapped in-cluster NFS stack:
# * nfs-server: nfs-ganesha backed by a PVC + stunnel sidecar on 20490
# * stunnel-client DaemonSet: terminates kubelet-side plain NFS on
#   127.0.0.1:2049 and forwards it mTLS to nfs-server:20490
# * StorageClass "nfs" points at 127.0.0.1 so kubelet hits each node's
#   local stunnel-client via hostNetwork
kubectl apply \
    -f nfs/nfs-server-pvc.yaml \
    -f nfs/nfs-server-service.yaml \
    -f nfs/nfs-server-ganesha-configmap.yaml \
    -f nfs/nfs-server-stunnel-configmap.yaml \
    -f nfs/nfs-server-deployment.yaml \
    -f nfs/stunnel-client-configmap.yaml \
    -f nfs/stunnel-client-daemonset.yaml \
    -f nfs/storageclass.yaml

# ConfigMap updates via `subPath` mount do not propagate to running pods
# — Kubernetes only re-reads subPath-mounted ConfigMaps when the pod
# recreates. Trigger a rollout restart on both the nfs-server Deployment
# and the nfs-stunnel-client DaemonSet so re-running kub-up with
# ConfigMap edits actually takes effect. On first apply this restarts
# the just-created pods (not a no-op, but cheap and idempotent).
echo "...rolling nfs-server + nfs-stunnel-client to pick up any config changes..."
kubectl rollout restart deployment/nfs-server
kubectl rollout restart daemonset/nfs-stunnel-client
# With readinessProbes on both (stunnel sidecar :20490 on the
# nfs-server pod, stunnel on loopback :12049 on the DaemonSet),
# `kubectl rollout status` is a meaningful wait rather than a
# pod-count check — it blocks until the probes succeed.
echo "...waiting for nfs-server + nfs-stunnel-client to be listening..."
kubectl rollout status deployment/nfs-server --timeout=180s
kubectl rollout status daemonset/nfs-stunnel-client --timeout=180s

kubectl apply \
    -f mysql/configmap.yaml \
    -f mysql/secret.yaml \
    -f mysql/replication-secret.yaml \
    -f mysql/service.yaml \
    -f mysql/statefulset.yaml \
    -f redis/secret.yaml \
    -f redis/configmap-main.yaml \
    -f redis/configmap-acl.yaml \
    -f redis/statefulset-redis.yaml \
    -f redis/statefulset-sentinel.yaml \
    -f redis/service-redis.yaml \
    -f redis/service-sentinel.yaml \
    -f phpmyadmin/configmap.yaml \
    -f phpmyadmin/deployment.yaml \
    -f phpmyadmin/service.yaml \
    -f volumes/letsencrypt.yaml \
    -f volumes/ssl.yaml \
    -f volumes/website.yaml \
    -f openemr/secret.yaml \
    -f openemr/deployment.yaml \
    -f openemr/service.yaml \
    -f network/policies.yaml
